From 8cae6c2377f0a464812c72ec34b3f25608ad1412 Mon Sep 17 00:00:00 2001
From: tacitech <contact@tacitek.com>
Date: Sat, 14 Nov 2026 19:50:31 +0700
Subject: [PATCH 17/20] nyx_power: system_power for the NyxHop baseboard from
 its ADS1115 (AIN3 = 5V_PER / 2 through R43/R44 10k / 10k as voltage5v_v, the
 battery input AIN0 / 11 as brick 1 from 5 V, usb_connected 0), started in
 nyxhop-bb.config after battery_status; Linux has no board_adc, so commander's
 power check failed 'system power unavailable' and CBRK_SUPPLY_CHK had to be
 set

---
 boards/nyxhop/zynq/default.px4board   |   1 +
 boards/nyxhop/zynq/nyxhop-bb.config   |   3 +
 boards/nyxhop/zynq/src/board_config.h |   7 +-
 src/drivers/nyx_power/CMakeLists.txt  |   8 ++
 src/drivers/nyx_power/Kconfig         |   6 +
 src/drivers/nyx_power/nyx_power.cpp   | 165 ++++++++++++++++++++++++++
 6 files changed, 189 insertions(+), 1 deletion(-)
 create mode 100644 src/drivers/nyx_power/CMakeLists.txt
 create mode 100644 src/drivers/nyx_power/Kconfig
 create mode 100644 src/drivers/nyx_power/nyx_power.cpp

diff --git a/boards/nyxhop/zynq/default.px4board b/boards/nyxhop/zynq/default.px4board
index 256151b..5f9d946 100644
--- a/boards/nyxhop/zynq/default.px4board
+++ b/boards/nyxhop/zynq/default.px4board
@@ -14,6 +14,7 @@ CONFIG_DRIVERS_MAGNETOMETER_HMC5883=y
 CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310=y
 CONFIG_DRIVERS_MAGNETOMETER_QMC5883L=y
 CONFIG_DRIVERS_NYX_DSHOT=y
+CONFIG_DRIVERS_NYX_POWER=y
 CONFIG_DRIVERS_RC_CRSF_RC=y
 CONFIG_DRIVERS_RC_INPUT=y
 CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=y
diff --git a/boards/nyxhop/zynq/nyxhop-bb.config b/boards/nyxhop/zynq/nyxhop-bb.config
index 7bc5d9d..76c203f 100644
--- a/boards/nyxhop/zynq/nyxhop-bb.config
+++ b/boards/nyxhop/zynq/nyxhop-bb.config
@@ -12,6 +12,8 @@
 #   RC       /dev/ttyS0 (J_RC): CRSF / ELRS (crsf_rc). For SBUS: rc_input on it instead, the PL
 #            inverting RC_RX (EMIO GPIO bit 62 = 1), and RC_TX_DIR (bit 57) left 0.
 #   battery  the ADS1115's AIN0 = VBAT / 11 (battery_status): BAT1_V_DIV against a meter.
+#   power    the ADS1115's AIN3 = 5V_PER / 2 and AIN0 (nyx_power): system_power for commander's
+#            power check (4.7..5.4 V, the battery as brick 1), so CBRK_SUPPLY_CHK stays 0.
 #   TELEM1   /dev/ttyS1: MAVLink at 115200 for a MicoAir MTF-01 (optical flow + range finder, its
 #            protocol set to Mav_PX4: OPTICAL_FLOW_RAD and DISTANCE_SENSOR). The ground station's
 #            MAVLink goes over the NyxHop link (UDP 14556/14557) as on the other configs.
@@ -68,6 +70,7 @@ gps start -d /dev/ttyPS1 -e /dev/ttyS2
 crsf_rc start -d /dev/ttyS0
 ads1115 start -X -b 12
 battery_status start
+nyx_power start
 for b in 11 12
 do
 	ist8310 -X -b $b start
diff --git a/boards/nyxhop/zynq/src/board_config.h b/boards/nyxhop/zynq/src/board_config.h
index a7ab2ab..46e4e45 100644
--- a/boards/nyxhop/zynq/src/board_config.h
+++ b/boards/nyxhop/zynq/src/board_config.h
@@ -20,9 +20,14 @@
 // SPI
 #define CONFIG_SPI 1
 
-// the baseboard's ADS1115: AIN0 VBAT / 11 (100k / 10k), AIN1 an ESC's current output
+// the baseboard's ADS1115 (U16): AIN0 VBAT / 11 (R41/R42 100k / 10k), AIN1 an ESC's current output,
+// AIN2 RSSI, AIN3 5V_PER / 2 (R43/R44 10k / 10k: the 5 V of the ports, the 3V3 and the sensors' 3V3).
+// nyx_power publishes system_power from AIN3 and AIN0.
 #define ADC_BATTERY_VOLTAGE_CHANNEL	0
 #define ADC_BATTERY_CURRENT_CHANNEL	-1
+#define ADC_BATTERY_VOLTAGE_DIV		11.0f
+#define ADC_5V_RAIL_SENSE		3
+#define ADC_5V_RAIL_DIV			2.0f
 
 #include <system_config.h>
 #include <px4_platform_common/board_common.h>
diff --git a/src/drivers/nyx_power/CMakeLists.txt b/src/drivers/nyx_power/CMakeLists.txt
new file mode 100644
index 0000000..305f77e
--- /dev/null
+++ b/src/drivers/nyx_power/CMakeLists.txt
@@ -0,0 +1,8 @@
+px4_add_module(
+	MODULE drivers__nyx_power
