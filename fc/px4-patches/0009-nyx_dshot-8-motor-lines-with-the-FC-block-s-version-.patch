diff --git a/src/lib/nyx_fcio/nyx_fcio.hpp b/src/lib/nyx_fcio/nyx_fcio.hpp
index 7eb0235..5dd6794 100644
--- a/src/lib/nyx_fcio/nyx_fcio.hpp
+++ b/src/lib/nyx_fcio/nyx_fcio.hpp
@@ -3,7 +3,8 @@
  *
  * The NyxHop board's flight controller I/O block in the PL (fpga/rtl/nyx_fcio.v in NyxHop-FC):
  * an ICM-42688-P on the PS's SPI1 (read by the icm42688p driver over /dev/spidev) whose accel and
- * gyro values are written here, and 4 motor lines, each DShot or (version 2) PWM, read back.
+ * gyro values are written here, and 4 motor lines (8 from version 3), each DShot or (version 2)
+ * PWM, read back (lines 1..4, when the block has its HIL parts).
  * Mapped from /dev/mem (root). Only with a bitstream that has the block: elsewhere the address
  * is not decoded and an access faults.
  */
@@ -48,8 +49,18 @@ enum Reg : uint32_t {
 	PWM_US       = 0x84, // ..0x90: [11:0] each PWM line's pulse, us
 	PWM_FS_US    = 0x94, // ..0xA0: [11:0] the pulse before the first DSHOT_GO, in the failsafe, with kill
 	PWM_RX       = 0xA4, // ..0xB0: [11:0] each PWM line's last pulse measured, us; [31] a pulse seen
+	// version 3: lines 5..8 (the baseboard's CH5..8; the read-back stays on lines 1..4)
+	DSHOT_TX_HI  = 0xB4, // ..0xC0
+	PWM_US_HI    = 0xC4, // ..0xD0
+	PWM_FS_US_HI = 0xD4, // ..0xE0
+	CAPS         = 0xFC, // [0] HIL: the emulated IMU and the read-back are in the block (0 on the baseboard)
 };
 
+// a line's registers, lines 0..7
+static constexpr uint32_t dshot_tx(unsigned i) { return i < 4 ? DSHOT_TX + 4 * i : DSHOT_TX_HI + 4 * (i - 4); }
+static constexpr uint32_t pwm_us(unsigned i) { return i < 4 ? PWM_US + 4 * i : PWM_US_HI + 4 * (i - 4); }
+static constexpr uint32_t pwm_fs_us(unsigned i) { return i < 4 ? PWM_FS_US + 4 * i : PWM_FS_US_HI + 4 * (i - 4); }
+
 // the chip's scales in high-resolution FIFO packets (20 bit)
 static constexpr float ACCEL_LSB_PER_G = 32768.f;
 static constexpr float GYRO_LSB_PER_DPS = 262.f;
@@ -86,9 +97,16 @@ public:
 		return (rd(VER) >> 16) == ID;
 	}
 
-	/** the block's version: 1 DShot only, 2 PWM too */
+	/** the block's version: 1 DShot only, 2 PWM too, 3 eight lines */
 	uint32_t version() const { return rd(VER) & 0xFFFF; }
 
+	/** its motor lines */
+	unsigned lines() const { return version() >= 3 ? 8 : 4; }
+
+	/** the emulated IMU and the read-back (DSHOT_RX, PWM_RX) are there: all before version 3,
+	 * from 3 the block's HIL parameter (0 in the baseboard's image) */
+	bool hil() const { return version() < 3 || (rd(CAPS) & 1); }
+
 	// (off: a register's byte address, a multiple of 4)
 	uint32_t rd(uint32_t off) const { return static_cast<volatile uint32_t *>(_p)[off / 4]; }
 	void wr(uint32_t off, uint32_t v) { static_cast<volatile uint32_t *>(_p)[off / 4] = v; }
