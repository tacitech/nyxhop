+int NyxDShot::custom_command(int argc, char *argv[])
+{
+	const char *verb = argv[0];
+	int motor = 0;		// 1..8, 0 all
+	int command = -1;
+	int repeat = -1;
+	int myoptind = 1;
+	int ch;
+	const char *myoptarg = nullptr;
+
+	while ((ch = px4_getopt(argc, argv, "m:c:r:", &myoptind, &myoptarg)) != EOF) {
+		switch (ch) {
+		case 'm':
+			motor = (int)strtol(myoptarg, nullptr, 10);
+			break;
+
+		case 'c':
+			command = (int)strtol(myoptarg, nullptr, 10);
+			break;
+
+		case 'r':
+			repeat = (int)strtol(myoptarg, nullptr, 10);
+			break;
+
+		default:
+			return print_usage("unrecognized flag");
+		}
+	}
+
+	// as PX4's dshot driver: BLHeli_S/BLHeli_32/Bluejay take direction 1/2 (7/8) and save (12)
+	// only after 6 of them in a row
+	struct Verb {
+		const char *name;
+		int command;
+		int repeat;
+	};
+
+	static constexpr Verb verbs[] = {
+		{"reverse", 8, 10}, {"normal", 7, 10}, {"save", 12, 10},
+		{"beep1", 1, 1}, {"beep2", 2, 1}, {"beep3", 3, 1}, {"beep4", 4, 1}, {"beep5", 5, 1},
+		{"cmd", -1, 10},
+	};
+
+	for (const Verb &v : verbs) {
+		if (strcmp(verb, v.name) != 0) {
+			continue;
+		}
+
+		const int c = v.command >= 0 ? v.command : command;
+		const int r = repeat > 0 ? repeat : v.repeat;
+
+		if (c < 1 || c > 47) {
+			return print_usage("a DShot command is 1..47 (-c)");
+		}
+
+		if (r < 1 || r > 100) {
+			return print_usage("repeats 1..100 (-r)");
+		}
+
+		if (motor < 0 || motor > (int)MAX_OUT) {
+			return print_usage("motor 1..8, 0 all (-m)");
+		}
+
+		if (!is_running()) {
+			PX4_ERR("not running");
+			return PX4_ERROR;
+		}
+
+		return get_instance()->send_command(c, motor == 0 ? 0xFFu : 1u << (motor - 1), r);
+	}
+
+	return print_usage("unknown command");
+}
