+	/** a DShot command (1..47) to the stopped DShot motors in mask, repeat frames; returns once sent */
+	int send_command(uint32_t command, uint32_t mask, int repeat)
+	{
+		mask &= ~(uint32_t)_pwm_mask & ((1u << _n_out) - 1);
+
+		if (mask == 0) {
+			PX4_ERR("no DShot motor to send it to");
+			return PX4_ERROR;
+		}
+
+		if (_cmd_left.load() > 0) {
+			PX4_ERR("a command is still going out");
+			return PX4_ERROR;
+		}
+
+		_cmd_frame.store(nyx_fcio::dshot_frame(command, true));
+		_cmd_mask.store(mask);
+		_cmd_left.store(repeat);
+
+		// a frame per mixer update; 2 s at most
+		for (int t = 0; t < 2000 && _cmd_left.load() > 0; t++) {
+			px4_usleep(1000);
+		}
+
+		const int left = _cmd_left.load();
+		_cmd_left.store(0);
+
+		if (left < 0) {
+			PX4_ERR("not sent: a motor is running (commands go to stopped motors only)");
+			return PX4_ERROR;
+		}
+
+		if (left > 0) {
+			PX4_ERR("not sent: no mixer updates");
+			return PX4_ERROR;
+		}
+
+		PX4_INFO("DShot command %u sent %d times to motors 0x%02x", (unsigned)command, repeat, (unsigned)mask);
+		return PX4_OK;
+	}
