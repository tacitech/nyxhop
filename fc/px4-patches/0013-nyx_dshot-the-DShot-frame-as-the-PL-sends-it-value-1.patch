 	bool updateOutputs(uint16_t outputs[MAX_ACTUATORS], unsigned num_outputs,
 			   unsigned num_control_groups_updated) override
 	{
+		// an ESC command going out (send_command): to its motors only while all of them are stopped
+		uint32_t cmd_mask = 0;
+
+		if (_cmd_left.load() > 0) {
+			cmd_mask = _cmd_mask.load();
+
+			for (unsigned i = 0; i < _n_out; i++) {
+				const uint16_t o = i < num_outputs ? outputs[i] : 0;
+
+				if ((cmd_mask & (1u << i)) && o != 0 && o != UINT16_MAX) {
+					_cmd_left.store(-1);
+					cmd_mask = 0;
+					break;
+				}
+			}
+		}
+
+		const uint32_t cmd_frame = _cmd_frame.load();
+
 		for (unsigned i = 0; i < _n_out; i++) {
 			const uint16_t o = i < num_outputs ? outputs[i] : 0;
 			const bool stop = o == 0 || o == UINT16_MAX;
@@ -132,16 +159,66 @@ public:
 				// the pulse in us; stopped (failsafe): the disarmed pulse
 				_fcio.wr(nyx_fcio::pwm_us(i), stop ? _pwm_dis[i] : math::min<uint32_t>(o, PWM_MAX_US));
 
+			} else if (stop) {
+				// 0 (disarmed, or failsafe) stops the motor, or the command
+				_fcio.wr(nyx_fcio::dshot_tx(i), (cmd_mask & (1u << i)) ? cmd_frame : 0);
+
 			} else {
-				// 0 (disarmed, or failsafe) stops the motor; 1..1999 = DShot 48..2046
-				_fcio.wr(nyx_fcio::dshot_tx(i), stop ? 0 : math::min<uint32_t>(o, DSHOT_MAX) + 47);
+				// 1..1999 = DShot 48..2046
+				_fcio.wr(nyx_fcio::dshot_tx(i), nyx_fcio::dshot_frame(math::min<uint32_t>(o, DSHOT_MAX) + 47));
 			}
 		}
 
 		_fcio.wr(nyx_fcio::DSHOT_GO, 1);
+
+		if (cmd_mask) {
+			_cmd_left.fetch_sub(1);
+		}
