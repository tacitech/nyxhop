 	DROPPED      = 0x3C,
-	DSHOT_TX     = 0x40, // ..0x4C: [10:0] throttle, [11] telemetry
+	DSHOT_TX     = 0x40, // ..0x4C: the frame's 12 bits as they go out, [11] first: dshot_frame()
 	DSHOT_GO     = 0x50,
 	DSHOT_SENT   = 0x54,
 	DSHOT_WD     = 0x58, // ms without DSHOT_GO before the block sends throttle 0 itself (0 off)
 	DSHOT_FS     = 0x5C, // [15:0] failsafe trips, [31] failsafe now
-	DSHOT_RX     = 0x60, // ..0x6C: [10:0] throttle, [11] telemetry, [31] a good frame seen
+	DSHOT_RX     = 0x60, // ..0x6C: [11:0] the 12 bits read back (dshot_throttle()), [31] a good frame seen
 	DSHOT_GOOD   = 0x70,
 	DSHOT_BAD    = 0x74,
 	DSHOT_BITPER = 0x78,
@@ -61,6 +61,13 @@ static constexpr uint32_t dshot_tx(unsigned i) { return i < 4 ? DSHOT_TX + 4 * i
 static constexpr uint32_t pwm_us(unsigned i) { return i < 4 ? PWM_US + 4 * i : PWM_US_HI + 4 * (i - 4); }
 static constexpr uint32_t pwm_fs_us(unsigned i) { return i < 4 ? PWM_FS_US + 4 * i : PWM_FS_US_HI + 4 * (i - 4); }
 
+// A DShot frame's 12 bits in the order an ESC takes them: the 11 bit value (0 stop, 1..47 commands,
+// 48..2047 throttle), then the telemetry request (set with a command, as other flight controllers
+// do). The block sends DSHOT_TX[11:0] as it is, [11] first, and adds the CRC; its read-back
+// (DSHOT_RX) holds the 12 bits the same way.
+static constexpr uint32_t dshot_frame(uint32_t value, bool telemetry = false) { return (value & 0x7FF) << 1 | (telemetry ? 1u : 0u); }
+static constexpr uint32_t dshot_value(uint32_t frame) { return (frame >> 1) & 0x7FF; }
+
 // the chip's scales in high-resolution FIFO packets (20 bit)
 static constexpr float ACCEL_LSB_PER_G = 32768.f;
 static constexpr float GYRO_LSB_PER_DPS = 262.f;
