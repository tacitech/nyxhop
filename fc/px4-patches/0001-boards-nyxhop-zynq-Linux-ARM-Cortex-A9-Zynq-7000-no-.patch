diff --git a/boards/nyxhop/zynq/src/board_config.h b/boards/nyxhop/zynq/src/board_config.h
new file mode 100644
index 0000000..c035a93
--- /dev/null
+++ b/boards/nyxhop/zynq/src/board_config.h
@@ -0,0 +1,25 @@
+/****************************************************************************
+ *
+ *   NyxHop on a Zynq-7000 board (ADRV9364/9361 + carrier, Linux): PX4 runs on the ARM next to the
+ *   NyxHop link daemon. Step 1 has no sensors attached (SIH simulates them); the buses below are
+ *   the PS's, for the IMU / baro of step 2.
+ *
+ ****************************************************************************/
+
+#pragma once
+
+#define BOARD_OVERRIDE_UUID "NYXZYNQ000000000" // must be of length 16
+#define PX4_SOC_ARCH_ID     PX4_SOC_ARCH_ID_UNUSED
+
+// I2C
+#define CONFIG_I2C 1
+#define PX4_NUMBER_I2C_BUSES    1
+
+// SPI
+#define CONFIG_SPI 1
+
+#define ADC_BATTERY_VOLTAGE_CHANNEL	-1
+#define ADC_BATTERY_CURRENT_CHANNEL	-1
+
+#include <system_config.h>
+#include <px4_platform_common/board_common.h>
diff --git a/boards/nyxhop/zynq/src/i2c.cpp b/boards/nyxhop/zynq/src/i2c.cpp
new file mode 100644
index 0000000..437c5a5
--- /dev/null
+++ b/boards/nyxhop/zynq/src/i2c.cpp
@@ -0,0 +1,6 @@
+#include <px4_arch/i2c_hw_description.h>
+
+// /dev/i2c-1 on the carrier's header (the baro / mag of step 2)
+constexpr px4_i2c_bus_t px4_i2c_buses[I2C_BUS_MAX_BUS_ITEMS] = {
+	initI2CBusExternal(1),
+};
diff --git a/boards/nyxhop/zynq/src/spi.cpp b/boards/nyxhop/zynq/src/spi.cpp
new file mode 100644
index 0000000..96cdf33
--- /dev/null
+++ b/boards/nyxhop/zynq/src/spi.cpp
@@ -0,0 +1,9 @@
+#include <px4_arch/spi_hw_description.h>
+#include <drivers/drv_sensor.h>
+
+// /dev/spidev1.0 on the carrier's header (the IMU of step 2)
+constexpr px4_spi_bus_t px4_spi_buses[SPI_BUS_MAX_BUS_ITEMS] = {
+	initSPIBus(1, {
+		initSPIDevice(DRV_IMU_DEVTYPE_ICM42688P, 0),
+	}),
+};
