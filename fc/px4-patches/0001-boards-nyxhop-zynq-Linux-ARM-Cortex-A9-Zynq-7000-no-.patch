diff --git a/boards/nyxhop/zynq/nyxhop-sih.config b/boards/nyxhop/zynq/nyxhop-sih.config
new file mode 100644
index 0000000..32fd0a3
--- /dev/null
+++ b/boards/nyxhop/zynq/nyxhop-sih.config
@@ -0,0 +1,73 @@
+#!/bin/sh
+# NyxHop Zynq, step 1: PX4 on the board's ARM with the SIH quad X (no sensors attached: SIH
+# simulates the vehicle, its IMU, GPS, baro and mag in real time), MAVLink to the ground over the
+# NyxHop link. Run from the folder holding bin/ and etc/:
+#   PATH=$PWD/bin:$PATH ./bin/px4 -d -s nyxhop-sih.config
+. px4-alias.sh
+
+param select parameters.bson
+if [ -f parameters.bson ]
+then
+	param import
+fi
+
+# the vehicle: the multicopter defaults, then SIH's quad X (init.d-posix/airframes/10040_sihsim_quadx)
+. etc/init.d/rc.mc_defaults
+param set-default MAV_TYPE 2
+param set-default SENS_EN_GPSSIM 1
+param set-default SENS_EN_BAROSIM 1
+param set-default SENS_EN_MAGSIM 1
+param set-default CA_ROTOR_COUNT 4
+param set-default CA_ROTOR0_PX 1
+param set-default CA_ROTOR0_PY 1
+param set-default CA_ROTOR1_PX -1
+param set-default CA_ROTOR1_PY -1
+param set-default CA_ROTOR2_PX 1
+param set-default CA_ROTOR2_PY -1
+param set-default CA_ROTOR2_KM -0.05
+param set-default CA_ROTOR3_PX -1
+param set-default CA_ROTOR3_PY 1
+param set-default CA_ROTOR3_KM -0.05
+param set-default HIL_ACT_FUNC1 101
+param set-default HIL_ACT_FUNC2 102
+param set-default HIL_ACT_FUNC3 103
+param set-default HIL_ACT_FUNC4 104
+param set-default EKF2_GPS_DELAY 0
+param set SIH_VEHICLE_TYPE 0
+param set-default IMU_INTEG_RATE 250
+param set-default COM_MODE_ARM_CHK 1
+# the simulated sensors' ids (as SITL calibrates them)
+param set-default CAL_ACC0_ID 1310988
+param set-default CAL_GYRO0_ID 1310988
+param set-default CAL_MAG0_ID 197388
+param set-default CAL_MAG0_PRIO 50
+param set-default SENS_BOARD_X_OFF 0.000001
+param set-default BAT1_N_CELLS 4
+# no RC receiver: commands come from the ground station only; the load checks off (measured,
+# not gating the arm)
+param set-default COM_RC_IN_MODE 4
+param set-default COM_CPU_MAX -1
+param set-default COM_RAM_MAX -1
+param set-default EKF2_REQ_GPS_H 0.5
+
+dataman start -f dataman
+simulator_sih start
+sensor_baro_sim start
+sensor_gps_sim start
+sensor_mag_sim start
+load_mon start
+battery_simulator start
+system_power_simulator start
+rc_update start
+manual_control start
+sensors start
+commander start
+ekf2 start &
+pwm_out_sim start -m sim
+. etc/init.d/rc.vehicle_setup
+navigator start
+
+# MAVLink over the NyxHop link: nyx-ipcam on this board takes datagrams on 14557 up the link and
+# hands what comes down to 14556 (its --tlm-out)
+mavlink start -x -u 14556 -o 14557 -t 127.0.0.1 -r 20000
+mavlink boot_complete
