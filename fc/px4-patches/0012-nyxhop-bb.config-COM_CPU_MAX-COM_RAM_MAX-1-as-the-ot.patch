From 3a0e1820994771a197aa3f8aa80e2b8367d0bf71 Mon Sep 17 00:00:00 2001
From: tacitech <contact@tacitek.com>
Date: Mon, 9 Nov 2026 18:37:30 +0700
Subject: [PATCH 12/13] nyxhop-bb.config: COM_CPU_MAX/COM_RAM_MAX -1 as the
 other nyxhop configs

---
 boards/nyxhop/zynq/nyxhop-bb.config | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/boards/nyxhop/zynq/nyxhop-bb.config b/boards/nyxhop/zynq/nyxhop-bb.config
index 50951e1..afd39bc 100644
--- a/boards/nyxhop/zynq/nyxhop-bb.config
+++ b/boards/nyxhop/zynq/nyxhop-bb.config
@@ -51,6 +51,9 @@ param set-default NYX_DSHOT_FUNC3 103
 param set-default NYX_DSHOT_FUNC4 104
 param set-default NYX_DSHOT_RATE 600
 param set-default IMU_INTEG_RATE 250
+# (as the other nyxhop configs: Linux's CPU/RAM load is not the NuttX one these checks are for)
+param set-default COM_CPU_MAX -1
+param set-default COM_RAM_MAX -1
 # sticks come over the NyxHop link (the pilot app); 2 to fly on the RC on J_RC as well
 param set-default COM_RC_IN_MODE 1
 param set-default BAT1_SOURCE 0
