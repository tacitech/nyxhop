index 7a62772..256151b 100644
--- a/boards/nyxhop/zynq/default.px4board
+++ b/boards/nyxhop/zynq/default.px4board
@@ -3,10 +3,21 @@ CONFIG_BOARD_LINUX_TARGET=y
