diff --git a/src/drivers/nyx_dshot/nyx_dshot.cpp b/src/drivers/nyx_dshot/nyx_dshot.cpp
new file mode 100644
index 0000000..b9d0406
--- /dev/null
+++ b/src/drivers/nyx_dshot/nyx_dshot.cpp
@@ -0,0 +1,179 @@
+/**
+ * @file nyx_dshot.cpp
+ *
+ * DShot out from the NyxHop board's PL (nyx_fcio): the mixer's 4 motor outputs written to the
+ * block, a frame on each line per update. Values as PX4's DShot driver: 0 disarmed (motor
+ * stopped), 1..1999 the throttle (DShot 48..2046). The line rate (DShot600 default) is the
+ * block's DSHOT_PERIOD, set here from NYX_DSHOT_RATE.
+ */
+
+#include <drivers/drv_hrt.h>
+#include <lib/mathlib/mathlib.h>
+#include <lib/mixer_module/mixer_module.hpp>
+#include <lib/nyx_fcio/nyx_fcio.hpp>
+#include <lib/perf/perf_counter.h>
+#include <px4_platform_common/log.h>
+#include <px4_platform_common/module.h>
+#include <px4_platform_common/module_params.h>
+#include <uORB/SubscriptionInterval.hpp>
+#include <uORB/topics/parameter_update.h>
+
+using namespace time_literals;
+
+class NyxDShot : public ModuleBase<NyxDShot>, public OutputModuleInterface
+{
+public:
+	NyxDShot() :
+		OutputModuleInterface(MODULE_NAME, px4::wq_configurations::hp_default)
+	{
+		_mixing_output.setAllDisarmedValues(0);
+		_mixing_output.setAllMinValues(1);
+		_mixing_output.setAllMaxValues(1999);
+		_mixing_output.setAllFailsafeValues(0);
+	}
+
+	~NyxDShot() override
+	{
+		perf_free(_cycle_perf);
+		perf_free(_interval_perf);
+	}
+
+	static int task_spawn(int argc, char *argv[]);
+	static int custom_command(int argc, char *argv[]) { return print_usage("unknown command"); }
+	static int print_usage(const char *reason = nullptr);
+
+	int init()
+	{
+		if (!_fcio.open()) {
+			PX4_ERR("no FC I/O block at 0x%08x (a bitstream without it?)", (unsigned)nyx_fcio::BASE);
+			return PX4_ERROR;
+		}
+
+		set_rate();
+		ScheduleNow();
+		return PX4_OK;
+	}
+
+	void Run() override
+	{
+		if (should_exit()) {
+			ScheduleClear();
+			_mixing_output.unregister();
+			exit_and_cleanup();
+			return;
+		}
+
+		perf_begin(_cycle_perf);
+		perf_count(_interval_perf);
+
+		_mixing_output.update();
+
+		if (_parameter_update_sub.updated()) {
+			parameter_update_s pupdate;
+			_parameter_update_sub.copy(&pupdate);
+			updateParams();
+			set_rate();
+		}
+
+		_mixing_output.updateSubscriptions(false);
+
+		perf_end(_cycle_perf);
+	}
+
+	bool updateOutputs(uint16_t outputs[MAX_ACTUATORS], unsigned num_outputs,
+			   unsigned num_control_groups_updated) override
+	{
+		for (unsigned i = 0; i < NUM_OUT; i++) {
+			const uint16_t o = i < num_outputs ? outputs[i] : 0;
+			// 0 (disarmed, or failsafe) stops the motor; 1..1999 = DShot 48..2046
+			const uint32_t v = (o == 0 || o == UINT16_MAX) ? 0 : math::min<uint32_t>(o, 1999) + 47;
+			_fcio.wr(nyx_fcio::DSHOT_TX + 4 * i, v);
+		}
+
+		_fcio.wr(nyx_fcio::DSHOT_GO, 1);
+		return true;
+	}
+
+	int print_status() override
+	{
+		perf_print_counter(_cycle_perf);
+		perf_print_counter(_interval_perf);
+		PX4_INFO("DShot%d: %u frames sent; read back %u good, %u bad; bit %u clocks",
+			 _param_rate.get(), (unsigned)_fcio.rd(nyx_fcio::DSHOT_SENT), (unsigned)_fcio.rd(nyx_fcio::DSHOT_GOOD),
+			 (unsigned)_fcio.rd(nyx_fcio::DSHOT_BAD), (unsigned)_fcio.rd(nyx_fcio::DSHOT_BITPER));
+
+		for (unsigned i = 0; i < NUM_OUT; i++) {
+			PX4_INFO("motor %u: out %4u, read back %4u", i, (unsigned)(_fcio.rd(nyx_fcio::DSHOT_TX + 4 * i) & 0x7FF),
+				 (unsigned)(_fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF));
+		}
+
+		_mixing_output.printStatus();
+		return 0;
+	}
+
+private:
+	static constexpr unsigned NUM_OUT = 4;
+
+	void set_rate()
+	{
+		// the block's clock is 200 MHz: a DShot600 bit = 333 clocks
+		const int rate = math::constrain((int)_param_rate.get(), 150, 1200);
+		_fcio.wr(nyx_fcio::DSHOT_PERIOD, (200000 + rate / 2) / rate);
+	}
+
+	MixingOutput _mixing_output{"NYX_DSHOT", NUM_OUT, *this, MixingOutput::SchedulingPolicy::Auto, false, false};
+	uORB::SubscriptionInterval _parameter_update_sub{ORB_ID(parameter_update), 1_s};
+	nyx_fcio::Map _fcio;
+
+	perf_counter_t _cycle_perf{perf_alloc(PC_ELAPSED, MODULE_NAME": cycle")};
+	perf_counter_t _interval_perf{perf_alloc(PC_INTERVAL, MODULE_NAME": interval")};
+
+	DEFINE_PARAMETERS(
+		(ParamInt<px4::params::NYX_DSHOT_RATE>) _param_rate
+	)
+};
+
+int NyxDShot::task_spawn(int argc, char *argv[])
+{
+	NyxDShot *instance = new NyxDShot();
+
+	if (instance) {
+		_object.store(instance);
+		_task_id = task_id_is_work_queue;
+
+		if (instance->init() == PX4_OK) {
+			return PX4_OK;
+		}
+
+	} else {
+		PX4_ERR("alloc failed");
+	}
+
+	delete instance;
+	_object.store(nullptr);
+	_task_id = -1;
+	return PX4_ERROR;
+}
+
+int NyxDShot::print_usage(const char *reason)
+{
+	if (reason) {
+		PX4_WARN("%s\n", reason);
+	}
+
+	PRINT_MODULE_DESCRIPTION(
+		R"DESCR_STR(
+### Description
+DShot out on 4 lines from the NyxHop board's PL (the nyx_fcio block), read back by its decoder.
+)DESCR_STR");
+
+	PRINT_MODULE_USAGE_NAME("nyx_dshot", "driver");
+	PRINT_MODULE_USAGE_COMMAND("start");
+	PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
+	return 0;
+}
+
+extern "C" __EXPORT int nyx_dshot_main(int argc, char *argv[])
+{
+	return NyxDShot::main(argc, argv);
+}
diff --git a/src/lib/nyx_fcio/nyx_fcio.hpp b/src/lib/nyx_fcio/nyx_fcio.hpp
new file mode 100644
index 0000000..ec02c9f
--- /dev/null
+++ b/src/lib/nyx_fcio/nyx_fcio.hpp
@@ -0,0 +1,90 @@
+/**
+ * @file nyx_fcio.hpp
+ *
+ * The NyxHop board's flight controller I/O block in the PL (fpga/rtl/nyx_fcio.v in NyxHop-FC):
+ * an ICM-42688-P on the PS's SPI1 (read by the icm42688p driver over /dev/spidev) whose accel and
+ * gyro values are written here, and DShot out on 4 lines with a decoder reading them back.
+ * Mapped from /dev/mem (root). Only with a bitstream that has the block: elsewhere the address
+ * is not decoded and an access faults.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace nyx_fcio
+{
+
+static constexpr uint32_t BASE = 0x43C70000;
+static constexpr uint32_t VERSION = 0x46430001;
+
+enum Reg : uint32_t {
+	VER          = 0x00,
+	CTRL         = 0x04,
+	DSHOT_PERIOD = 0x08,
+	TEMP         = 0x0C,
+	AX           = 0x10, // ..GZ at 0x24: 20 bit signed, the chip's frame (x fwd, y left, z up)
+	IMU_COMMIT   = 0x28,
+	IMU_STAT     = 0x2C,
+	PKTS         = 0x30,
+	SPI_XFERS    = 0x34,
+	RESETS       = 0x38,
+	DROPPED      = 0x3C,
+	DSHOT_TX     = 0x40, // ..0x4C: [10:0] throttle, [11] telemetry
+	DSHOT_GO     = 0x50,
+	DSHOT_SENT   = 0x54,
+	DSHOT_RX     = 0x60, // ..0x6C: [10:0] throttle, [11] telemetry, [31] a good frame seen
+	DSHOT_GOOD   = 0x70,
+	DSHOT_BAD    = 0x74,
+	DSHOT_BITPER = 0x78,
+};
+
+// the chip's scales in high-resolution FIFO packets (20 bit)
+static constexpr float ACCEL_LSB_PER_G = 32768.f;
+static constexpr float GYRO_LSB_PER_DPS = 262.f;
+
+class Map
+{
+public:
+	~Map()
+	{
+		if (_p != MAP_FAILED) {
+			munmap(_p, 0x1000);
+		}
+
+		if (_fd >= 0) {
+			::close(_fd);
+		}
+	}
+
+	/** map the block; true if its version is there */
+	bool open()
+	{
+		_fd = ::open("/dev/mem", O_RDWR | O_SYNC);
+
+		if (_fd < 0) {
+			return false;
+		}
+
+		_p = mmap(nullptr, 0x1000, PROT_READ | PROT_WRITE, MAP_SHARED, _fd, BASE);
+
+		if (_p == MAP_FAILED) {
+			return false;
+		}
+
+		return rd(VER) == VERSION;
+	}
+
+	// (off: a register's byte address, a multiple of 4)
+	uint32_t rd(uint32_t off) const { return static_cast<volatile uint32_t *>(_p)[off / 4]; }
+	void wr(uint32_t off, uint32_t v) { static_cast<volatile uint32_t *>(_p)[off / 4] = v; }
+
+private:
+	int _fd{-1};
+	void *_p{MAP_FAILED};
+};
+
+} // namespace nyx_fcio
