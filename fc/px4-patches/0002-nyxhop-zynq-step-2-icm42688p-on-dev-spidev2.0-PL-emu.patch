diff --git a/boards/nyxhop/zynq/fcio-spi.dtso b/boards/nyxhop/zynq/fcio-spi.dtso
new file mode 100644
index 0000000..2ce4946
--- /dev/null
+++ b/boards/nyxhop/zynq/fcio-spi.dtso
@@ -0,0 +1,26 @@
+/*
+ * fcio-spi.dtso - the PS's SPI1 (EMIO, disabled in the Kuiper device tree) on, with a spidev on
+ * chip select 0: /dev/spidev2.0 for PX4's icm42688p driver. Applied at run time (configfs):
+ *   dtc -@ -I dts -O dtb -o fcio-spi.dtbo fcio-spi.dtso
+ *   mkdir /sys/kernel/config/device-tree/overlays/fcio
+ *   cat fcio-spi.dtbo > /sys/kernel/config/device-tree/overlays/fcio/dtbo
+ */
+/dts-v1/;
+/plugin/;
+
+/ {
+	fragment@0 {
+		target-path = "/axi/spi@e0007000";
+		__overlay__ {
+			status = "okay";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			spidev@0 {
+				compatible = "rohm,dh2228fv";
+				reg = <0>;
+				spi-max-frequency = <25000000>;
+			};
+		};
+	};
+};
diff --git a/boards/nyxhop/zynq/nyxhop-hil.config b/boards/nyxhop/zynq/nyxhop-hil.config
new file mode 100644
index 0000000..bd68dea
--- /dev/null
+++ b/boards/nyxhop/zynq/nyxhop-hil.config
@@ -0,0 +1,75 @@
+#!/bin/sh
+# NyxHop Zynq, step 2: PX4 with its real I/O path and the vehicle still simulated. The IMU is the
+# icm42688p driver on /dev/spidev2.0, talking to the ICM-42688-P emulated in the PL (nyx_fcio);
+# the motors go out as DShot600 from the PL (nyx_dshot). SIH (SIH_PL_IO) reads the motors back
+# from the PL's DShot decoder and writes its accel/gyro into the emulated chip. Needs the bitstream
+# with nyx_fcio and the overlay fcio-spi.dtbo applied. Run from the folder holding bin/ and etc/:
+#   PATH=$PWD/bin:$PATH ./bin/px4 -d -s nyxhop-hil.config
+. px4-alias.sh
+
+param select parameters_hil.bson
+if [ -f parameters_hil.bson ]
+then
+	param import
+fi
+
+# the vehicle: the multicopter defaults, then SIH's quad X
+. etc/init.d/rc.mc_defaults
+param set-default MAV_TYPE 2
+param set-default SENS_EN_GPSSIM 1
+param set-default SENS_EN_BAROSIM 1
+param set-default SENS_EN_MAGSIM 1
+param set-default CA_ROTOR_COUNT 4
+param set-default CA_ROTOR0_PX 1
+param set-default CA_ROTOR0_PY 1
+param set-default CA_ROTOR1_PX -1
+param set-default CA_ROTOR1_PY -1
+param set-default CA_ROTOR2_PX 1
+param set-default CA_ROTOR2_PY -1
+param set-default CA_ROTOR2_KM -0.05
+param set-default CA_ROTOR3_PX -1
+param set-default CA_ROTOR3_PY 1
+param set-default CA_ROTOR3_KM -0.05
+param set-default NYX_DSHOT_FUNC1 101
+param set-default NYX_DSHOT_FUNC2 102
+param set-default NYX_DSHOT_FUNC3 103
+param set-default NYX_DSHOT_FUNC4 104
+param set-default EKF2_GPS_DELAY 0
+param set SIH_VEHICLE_TYPE 0
+param set SIH_PL_IO 1
+param set-default IMU_INTEG_RATE 250
+param set-default COM_MODE_ARM_CHK 1
+# the IMU: ICM-42688-P on SPI bus 2, chip select 0 (device id 0x260012); the simulated mag
+param set-default CAL_ACC0_ID 2490386
+param set-default CAL_GYRO0_ID 2490386
+param set-default CAL_MAG0_ID 197388
+param set-default CAL_MAG0_PRIO 50
+param set-default SENS_BOARD_X_OFF 0.000001
+param set-default BAT1_N_CELLS 4
+# no RC receiver: commands come from the ground station only; the load checks off
+param set-default COM_RC_IN_MODE 4
+param set-default COM_CPU_MAX -1
+param set-default COM_RAM_MAX -1
+param set-default EKF2_REQ_GPS_H 0.5
+
+dataman start -f dataman
+simulator_sih start
+sensor_baro_sim start
+sensor_gps_sim start
+sensor_mag_sim start
+icm42688p -s -b 2 start
+load_mon start
+battery_simulator start
+system_power_simulator start
+rc_update start
+manual_control start
+sensors start
+commander start
+ekf2 start &
+nyx_dshot start
+. etc/init.d/rc.vehicle_setup
+navigator start
+
+# MAVLink over the NyxHop link (nyx-ipcam: 14557 up the link, 14556 what comes down)
+mavlink start -x -u 14556 -o 14557 -t 127.0.0.1 -r 20000
+mavlink boot_complete
