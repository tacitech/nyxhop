+		_px4_accel.update(time_now_us, accel(0), accel(1), accel(2));
+		_px4_gyro.update(time_now_us, gyro(0), gyro(1), gyro(2));
+	}
+}
+
+void Sih::pl_read_motors(const float dt)
+{
+#if defined(__PX4_POSIX)
+	_last_actuator_output_time = hrt_absolute_time();
+
+	for (int i = 0; i < 4; i++) {
+		// DShot: 0 stop (and 1..47 commands), 48..2047 the throttle
+		const uint32_t thr = _fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF;
+		const float u_sp = thr >= 48 ? (thr - 48) / 1999.f : 0.f;
+		_u[i] = _u[i] + dt / _T_TAU * (u_sp - _u[i]); // first order transfer function with time constant tau
+	}
+#endif
+}
+
+void Sih::pl_write_imu(const Vector3f &accel, const Vector3f &gyro)
+{
+#if defined(__PX4_POSIX)
+	// the chip's frame is x forward, y left, z up (the driver flips y and z back); 20 bit
+	const float a = nyx_fcio::ACCEL_LSB_PER_G / CONSTANTS_ONE_G;
+	const float g = nyx_fcio::GYRO_LSB_PER_DPS * (180.f / M_PI_F);
+	const float v[6] = {accel(0) * a, -accel(1) * a, -accel(2) * a, gyro(0) * g, -gyro(1) * g, -gyro(2) * g};
+
+	for (int i = 0; i < 6; i++) {
+		const int32_t x = (int32_t)lroundf(constrain(v[i], -524287.f, 524287.f));
+		_fcio.wr(nyx_fcio::AX + 4 * i, (uint32_t)x & 0xFFFFF);
+	}
+
+	_fcio.wr(nyx_fcio::IMU_COMMIT, 1);
+#endif
 }
 
