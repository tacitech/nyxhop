@@ -94,9 +125,16 @@ public:
 	{
 		for (unsigned i = 0; i < NUM_OUT; i++) {
 			const uint16_t o = i < num_outputs ? outputs[i] : 0;
-			// 0 (disarmed, or failsafe) stops the motor; 1..1999 = DShot 48..2046
-			const uint32_t v = (o == 0 || o == UINT16_MAX) ? 0 : math::min<uint32_t>(o, 1999) + 47;
-			_fcio.wr(nyx_fcio::DSHOT_TX + 4 * i, v);
