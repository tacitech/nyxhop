 /**
  * @file nyx_dshot.cpp
  *
- * DShot out from the NyxHop board's PL (nyx_fcio): the mixer's 4 motor outputs written to the
- * block, a frame on each line per update. Values as PX4's DShot driver: 0 disarmed (motor
- * stopped), 1..1999 the throttle (DShot 48..2046). The line rate (DShot600 default) is the
- * block's DSHOT_PERIOD, set here from NYX_DSHOT_RATE. If this stops writing (PX4 dead or stuck)
- * the block itself sends throttle 0 after NYX_DSHOT_WD ms (100 by default: above the mixer's own
- * 50 ms backup schedule, which is all it runs on before the controllers publish).
+ * The motors out of the NyxHop board's PL (nyx_fcio): the mixer's 4 motor outputs written to the
+ * block, all lines updated at once per mixer update. Each line is DShot, or PWM if its bit is set
+ * in NYX_PWM_OUTS (the block's version 2).
+ *
+ * DShot: values as PX4's DShot driver: 0 disarmed (motor stopped), NYX_DSHOT_MIN..1999 the
+ * throttle (DShot 48..2046). The line rate (DShot600 default) is the block's DSHOT_PERIOD, set
+ * here from NYX_DSHOT_RATE.
+ * PWM: the pulse in us, NYX_PWM_DISn disarmed, NYX_PWM_MINn..NYX_PWM_MAXn armed, NYX_PWM_RATE
+ * pulses a second. The block makes the pulses on its own clock and never stops them: before the
+ * first update, in its failsafe and with kill they are NYX_PWM_DISn.
+ *
+ * If this stops writing (PX4 dead or stuck) the block itself stops the motors after NYX_DSHOT_WD
+ * ms (100 by default: above the mixer's own 50 ms backup schedule, which is all it runs on before
+ * the controllers publish): throttle 0 on DShot, the disarmed pulse on PWM.
  */
 
 #include <drivers/drv_hrt.h>
 #include <lib/mathlib/mathlib.h>
 #include <lib/mixer_module/mixer_module.hpp>
 #include <lib/nyx_fcio/nyx_fcio.hpp>
+#include <parameters/param.h>
 #include <lib/perf/perf_counter.h>
 #include <px4_platform_common/log.h>
 #include <px4_platform_common/module.h>
@@ -30,7 +39,7 @@ public:
