From f8889a44d27d58eb7525706a8667a7e980728867 Mon Sep 17 00:00:00 2001
From: tacitech <contact@tacitek.com>
Date: Wed, 21 Oct 2026 20:25:32 +0700
Subject: [PATCH 08/12] nyx_dshot: each motor DShot or PWM (NYX_PWM_OUTS,
 NYX_PWM_RATE 50-400 Hz, NYX_PWM_MIN/MAX/DIS per motor; the PL's failsafe
 pulse = NYX_PWM_DIS), NYX_DSHOT_MIN as DSHOT_MIN; nyx_fcio.hpp: block version
 2 registers (OUT_MODE, PWM_*), any version accepted; SIH_PL_IO reads a PWM
 line's measured pulse (1000-2000 us)

---
 src/drivers/nyx_dshot/module.yaml             |  93 +++++++++++-
 src/drivers/nyx_dshot/nyx_dshot.cpp           | 134 +++++++++++++++---
 src/lib/nyx_fcio/nyx_fcio.hpp                 |  17 ++-
 src/modules/simulation/simulator_sih/sih.cpp  |  18 ++-
 .../simulation/simulator_sih/sih_params.c     |   3 +-
 5 files changed, 234 insertions(+), 31 deletions(-)

diff --git a/src/drivers/nyx_dshot/module.yaml b/src/drivers/nyx_dshot/module.yaml
index ea6c639..27995b2 100644
--- a/src/drivers/nyx_dshot/module.yaml
+++ b/src/drivers/nyx_dshot/module.yaml
@@ -1,4 +1,4 @@
-module_name: NyxHop DShot (PL)
+module_name: NyxHop motor outputs (PL)
 actuator_output:
   output_groups:
     - param_prefix: NYX_DSHOT
@@ -19,13 +19,98 @@ parameters:
             default: 600
         NYX_DSHOT_WD:
             description:
-                short: DShot failsafe of the NyxHop PL outputs
+                short: Failsafe of the NyxHop PL outputs
                 long: |
-                    The PL sends throttle 0 on its own after this many ms without an update from
-                    PX4 (dead or stuck). 0 turns it off. Keep it above 50 ms: the mixer updates at
+                    The PL stops the motors on its own after this many ms without an update from
+                    PX4 (dead or stuck): DShot throttle 0, or on a PWM motor its NYX_PWM_DIS pulse
+                    (the pulses go on). 0 turns it off. Keep it above 50 ms: the mixer updates at
                     20 Hz before the controllers run.
             type: int32
             unit: ms
             min: 0
             max: 255
             default: 100
+        NYX_DSHOT_MIN:
+            description:
+                short: Minimum DShot motor output of the NyxHop PL outputs
+                long: |
+                    The lowest throttle while armed, as a fraction of full throttle (PX4's DSHOT_MIN
+                    for these outputs). Set it so that the motors always spin while armed.
+            type: float
+            unit: norm
+            min: 0
+            max: 1
+            decimal: 3
+            increment: 0.005
+            default: 0.055
+    - group: PWM Outputs
+      definitions:
+        NYX_PWM_OUTS:
+            description:
+                short: NyxHop PL motors on PWM instead of DShot
+                long: |
+                    The motors driven by a PWM ESC (a pulse NYX_PWM_MIN..NYX_PWM_MAX us at
+                    NYX_PWM_RATE); the others are DShot. On a PWM motor the PL never stops the
+                    pulses: before PX4 starts, in its failsafe and with kill it sends NYX_PWM_DIS
+                    (an old PWM ESC that loses its signal may hold the last throttle).
+            type: bitmask
+            bit:
+                0: Motor 1
+                1: Motor 2
+                2: Motor 3
+                3: Motor 4
+            min: 0
+            max: 15
+            default: 0
+            reboot_required: true
+        NYX_PWM_RATE:
+            description:
+                short: PWM rate of the NyxHop PL outputs
+                long: |
+                    Pulses per second on the PWM motors: 50 for any ESC, up to 400 for the
+                    multicopter ESCs that take it.
+            type: int32
+            unit: Hz
+            min: 50
+            max: 400
+            default: 50
+            reboot_required: true
+        NYX_PWM_MIN${i}:
+            description:
+                short: PWM minimum of NyxHop motor ${i}
+                long: |
+                    The pulse at the lowest throttle while armed (us). Only for a motor on PWM
+                    (NYX_PWM_OUTS).
+            type: int32
+            unit: us
+            min: 800
+            max: 1400
+            num_instances: 4
+            instance_start: 1
+            default: [1000, 1000, 1000, 1000]
+        NYX_PWM_MAX${i}:
+            description:
+                short: PWM maximum of NyxHop motor ${i}
+                long: |
+                    The pulse at full throttle (us). Only for a motor on PWM (NYX_PWM_OUTS).
+            type: int32
+            unit: us
+            min: 1600
+            max: 2200
+            num_instances: 4
+            instance_start: 1
+            default: [2000, 2000, 2000, 2000]
+        NYX_PWM_DIS${i}:
+            description:
+                short: PWM disarmed pulse of NyxHop motor ${i}
+                long: |
+                    The pulse while disarmed (us), and the one the PL itself sends before PX4
+                    starts, in its failsafe (NYX_DSHOT_WD) and with kill. Only for a motor on PWM
+                    (NYX_PWM_OUTS).
+            type: int32
+            unit: us
+            min: 800
+            max: 2200
+            num_instances: 4
+            instance_start: 1
+            default: [1000, 1000, 1000, 1000]
