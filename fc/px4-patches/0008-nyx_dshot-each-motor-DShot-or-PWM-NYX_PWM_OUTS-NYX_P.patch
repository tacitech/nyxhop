diff --git a/src/lib/nyx_fcio/nyx_fcio.hpp b/src/lib/nyx_fcio/nyx_fcio.hpp
index 46dea55..7eb0235 100644
--- a/src/lib/nyx_fcio/nyx_fcio.hpp
+++ b/src/lib/nyx_fcio/nyx_fcio.hpp
@@ -3,7 +3,7 @@
  *
  * The NyxHop board's flight controller I/O block in the PL (fpga/rtl/nyx_fcio.v in NyxHop-FC):
  * an ICM-42688-P on the PS's SPI1 (read by the icm42688p driver over /dev/spidev) whose accel and
- * gyro values are written here, and DShot out on 4 lines with a decoder reading them back.
+ * gyro values are written here, and 4 motor lines, each DShot or (version 2) PWM, read back.
  * Mapped from /dev/mem (root). Only with a bitstream that has the block: elsewhere the address
  * is not decoded and an access faults.
  */
@@ -19,7 +19,7 @@ namespace nyx_fcio
 {
 
 static constexpr uint32_t BASE = 0x43C70000;
-static constexpr uint32_t VERSION = 0x46430001;
+static constexpr uint32_t ID = 0x4643;      // VER's high half; the low half the version (2: PWM)
 
 enum Reg : uint32_t {
 	VER          = 0x00,
@@ -42,6 +42,12 @@ enum Reg : uint32_t {
 	DSHOT_GOOD   = 0x70,
 	DSHOT_BAD    = 0x74,
 	DSHOT_BITPER = 0x78,
+	// version 2
+	OUT_MODE     = 0x7C, // [3:0] line i PWM (1) or DShot (0)
+	PWM_PERIOD   = 0x80, // us from one PWM pulse to the next
+	PWM_US       = 0x84, // ..0x90: [11:0] each PWM line's pulse, us
+	PWM_FS_US    = 0x94, // ..0xA0: [11:0] the pulse before the first DSHOT_GO, in the failsafe, with kill
+	PWM_RX       = 0xA4, // ..0xB0: [11:0] each PWM line's last pulse measured, us; [31] a pulse seen
 };
 
 // the chip's scales in high-resolution FIFO packets (20 bit)
@@ -62,7 +68,7 @@ public:
 		}
 	}
 
-	/** map the block; true if its version is there */
+	/** map the block; true if it is there */
 	bool open()
 	{
 		_fd = ::open("/dev/mem", O_RDWR | O_SYNC);
@@ -77,9 +83,12 @@ public:
 			return false;
 		}
 
-		return rd(VER) == VERSION;
+		return (rd(VER) >> 16) == ID;
 	}
 
+	/** the block's version: 1 DShot only, 2 PWM too */
+	uint32_t version() const { return rd(VER) & 0xFFFF; }
+
 	// (off: a register's byte address, a multiple of 4)
 	uint32_t rd(uint32_t off) const { return static_cast<volatile uint32_t *>(_p)[off / 4]; }
 	void wr(uint32_t off, uint32_t v) { static_cast<volatile uint32_t *>(_p)[off / 4] = v; }
diff --git a/src/modules/simulation/simulator_sih/sih.cpp b/src/modules/simulation/simulator_sih/sih.cpp
index dd4220b..d0ebdd1 100644
--- a/src/modules/simulation/simulator_sih/sih.cpp
+++ b/src/modules/simulation/simulator_sih/sih.cpp
@@ -667,11 +667,23 @@ void Sih::pl_read_motors(const float dt)
 {
 #if defined(__PX4_POSIX)
 	_last_actuator_output_time = hrt_absolute_time();
+	// (the block's version 2: any line may be PWM)
+	const uint32_t pwm = _fcio.version() >= 2 ? _fcio.rd(nyx_fcio::OUT_MODE) : 0;
 
 	for (int i = 0; i < 4; i++) {
-		// DShot: 0 stop (and 1..47 commands), 48..2047 the throttle
-		const uint32_t thr = _fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF;
-		const float u_sp = thr >= 48 ? (thr - 48) / 1999.f : 0.f;
+		float u_sp;
+
+		if (pwm & (1u << i)) {
+			// PWM: the pulse measured, 1000..2000 us (an ESC's usual range)
+			const uint32_t us = _fcio.rd(nyx_fcio::PWM_RX + 4 * i) & 0xFFF;
+			u_sp = math::constrain((us - 1000.f) / 1000.f, 0.f, 1.f);
+
+		} else {
+			// DShot: 0 stop (and 1..47 commands), 48..2047 the throttle
+			const uint32_t thr = _fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF;
+			u_sp = thr >= 48 ? (thr - 48) / 1999.f : 0.f;
+		}
+
 		_u[i] = _u[i] + dt / _T_TAU * (u_sp - _u[i]); // first order transfer function with time constant tau
 	}
 #endif
