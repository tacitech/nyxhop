@@ -125,9 +177,47 @@ public:
 
 private:
 	static constexpr unsigned NUM_OUT = 4;
+	static constexpr uint16_t DSHOT_MAX = 1999;
+	static constexpr uint32_t PWM_MAX_US = 2200;
+
+	bool is_pwm(unsigned i) const { return _pwm_mask & (1u << i); }
+
+	/** a per-motor parameter, NAME1..NAME4 */
+	static int32_t param_motor(const char *name, unsigned i, int32_t dflt)
+	{
+		char n[17];
+		snprintf(n, sizeof(n), "%s%u", name, i + 1);
+		int32_t v = dflt;
+		const param_t h = param_find(n);
+
+		if (h != PARAM_INVALID) {
+			param_get(h, &v);
+		}
 
-	void set_rate()
+		return v;
+	}
+
+	/** the mixer's range of each line, and the block's DShot rate, watchdog and PWM minimum pulses */
+	void apply_params()
 	{
+		// we use a minimum value of 1, since 0 is for disarmed (as PX4's DShot driver)
+		const uint16_t dshot_min = math::constrain((int)(_param_dshot_min.get() * DSHOT_MAX), 1, (int)DSHOT_MAX);
+
+		for (unsigned i = 0; i < NUM_OUT; i++) {
+			if (is_pwm(i)) {
+				_pwm_dis[i] = math::constrain((int)param_motor("NYX_PWM_DIS", i, 1000), 800, (int)PWM_MAX_US);
+				_mixing_output.disarmedValue(i) = _pwm_dis[i];
+				_mixing_output.minValue(i) = math::constrain((int)param_motor("NYX_PWM_MIN", i, 1000), 800, 1400);
+				_mixing_output.maxValue(i) = math::constrain((int)param_motor("NYX_PWM_MAX", i, 2000), 1600, (int)PWM_MAX_US);
+				_fcio.wr(nyx_fcio::PWM_FS_US + 4 * i, _pwm_dis[i]);
+
+			} else {
+				_mixing_output.disarmedValue(i) = 0;
+				_mixing_output.minValue(i) = dshot_min;
+				_mixing_output.maxValue(i) = DSHOT_MAX;
+			}
+		}
+
 		// the block's clock is 200 MHz: a DShot600 bit = 333 clocks
 		const int rate = math::constrain((int)_param_rate.get(), 150, 1200);
 		_fcio.wr(nyx_fcio::DSHOT_PERIOD, (200000 + rate / 2) / rate);
@@ -137,13 +227,18 @@ private:
 	MixingOutput _mixing_output{"NYX_DSHOT", NUM_OUT, *this, MixingOutput::SchedulingPolicy::Auto, false, false};
 	uORB::SubscriptionInterval _parameter_update_sub{ORB_ID(parameter_update), 1_s};
 	nyx_fcio::Map _fcio;
+	uint8_t _pwm_mask{0};
+	uint16_t _pwm_dis[NUM_OUT] {1000, 1000, 1000, 1000};
 
 	perf_counter_t _cycle_perf{perf_alloc(PC_ELAPSED, MODULE_NAME": cycle")};
 	perf_counter_t _interval_perf{perf_alloc(PC_INTERVAL, MODULE_NAME": interval")};
 
 	DEFINE_PARAMETERS(
 		(ParamInt<px4::params::NYX_DSHOT_RATE>) _param_rate,
-		(ParamInt<px4::params::NYX_DSHOT_WD>) _param_wd
+		(ParamInt<px4::params::NYX_DSHOT_WD>) _param_wd,
+		(ParamFloat<px4::params::NYX_DSHOT_MIN>) _param_dshot_min,
+		(ParamInt<px4::params::NYX_PWM_OUTS>) _param_pwm_outs,
+		(ParamInt<px4::params::NYX_PWM_RATE>) _param_pwm_rate
 	)
 };
 
