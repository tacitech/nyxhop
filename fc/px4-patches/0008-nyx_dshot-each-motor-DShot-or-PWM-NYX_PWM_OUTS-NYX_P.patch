+			return PX4_ERROR;
+		}
+
+		apply_params();
+
+		if (_fcio.version() >= 2) {
+			// (each line's minimum pulse is in the block before it turns to PWM)
+			const int rate = math::constrain((int)_param_pwm_rate.get(), 50, 400);
+			_fcio.wr(nyx_fcio::PWM_PERIOD, (1000000 + rate / 2) / rate);
+			_fcio.wr(nyx_fcio::OUT_MODE, _pwm_mask);
+		}
+
 		ScheduleNow();
 		return PX4_OK;
 	}
@@ -62,9 +88,14 @@ public:
 			ScheduleClear();
