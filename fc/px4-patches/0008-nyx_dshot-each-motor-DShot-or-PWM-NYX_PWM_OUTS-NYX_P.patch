 			 (fs >> 31) ? "ON" : "off", (unsigned)(fs & 0xFFFF));
 
 		for (unsigned i = 0; i < NUM_OUT; i++) {
-			PX4_INFO("motor %u: out %4u, read back %4u", i, (unsigned)(_fcio.rd(nyx_fcio::DSHOT_TX + 4 * i) & 0x7FF),
-				 (unsigned)(_fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF));
+			if (is_pwm(i)) {
+				PX4_INFO("motor %u: PWM %4u us, read back %4u us (disarmed %u)", i + 1,
+					 (unsigned)(_fcio.rd(nyx_fcio::PWM_US + 4 * i) & 0xFFF),
+					 (unsigned)(_fcio.rd(nyx_fcio::PWM_RX + 4 * i) & 0xFFF), (unsigned)_pwm_dis[i]);
+
+			} else {
+				PX4_INFO("motor %u: DShot %4u, read back %4u", i + 1,
+					 (unsigned)(_fcio.rd(nyx_fcio::DSHOT_TX + 4 * i) & 0x7FF),
+					 (unsigned)(_fcio.rd(nyx_fcio::DSHOT_RX + 4 * i) & 0x7FF));
