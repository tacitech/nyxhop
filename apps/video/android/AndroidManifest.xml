<?xml version="1.0" encoding="utf-8"?>
<!-- NyxHop mobile (ground or aircraft end). No Java code: NativeActivity is part of the
     framework, everything runs in libnyx_mobile.so (Rust).
     hasCode="false" -> no classes.dex needed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nyxhop.mobile"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- to the board's daemon over WiFi or USB-C to Ethernet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the screen stays on while the video plays -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the phone's own camera as the aircraft video source (asked for at run time) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="NyxHop"
        android:hasCode="false"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:label="NyxHop"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask">
            <!-- the .so's name (without the lib prefix and the .so suffix) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="nyx_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
